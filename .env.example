# Copy to .env. Only server-side variables are used.
DATABASE_URL=postgresql://jev:jev_local_password@127.0.0.1:5434/jev?schema=public
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
# Optional X enrichment. No X calls are made without a token.
X_BEARER_TOKEN=
# Default per-analysis collection limit: 0 disables X; otherwise 10-100.
X_DEFAULT_TWEET_LIMIT=10
# Estimate per returned post. Verify current pricing in the X Developer Console.
X_POST_READ_COST_USD=0.005
# Optional new profile lookups are off in each analysis until explicitly selected.
# Maximum new/expired profiles per company: 0 disables paid profile lookups, otherwise 1-10.
X_PROFILE_LOOKUP_LIMIT=3
# Shared persistent profile cache lifetime (1-365 days).
X_PROFILE_CACHE_DAYS=30
# Estimate per returned user profile. Cached profiles require no new X read.
X_PROFILE_READ_COST_USD=0.01
# SEC fair-access contact. Set a real email, for example "Thesis contact@your-domain.com".
# Optional enrichment is unavailable until configured; no SEC API key or subscription needed.
SEC_USER_AGENT=
# 8/minute for Twelve Data Basic. Raise only when your plan allows it.
TWELVE_DATA_CREDITS_PER_MINUTE=8
# medium-term (3-12 months), long-term (1-3 years), or short-term (days-weeks)
INVESTMENT_HORIZON=medium-term
# Explicit synthetic workspace for development. Never a live fallback.
DEMO_MODE=false
# Required for production; HTTP Basic login uses username "personal".
# Use a random password of at least 16 characters and HTTPS outside localhost.
APP_PASSWORD=
# Optional fixed canonical origin for reverse-proxy deployments.
APP_ORIGIN=
# Required only for the HTTP cron endpoint. Use at least 32 random characters.
CRON_SECRET=
# Scheduler uses UTC. Default: every weekday after US market close.
DAILY_CRON=15 22 * * 1-5
# Estimated input price per million tokens; output tokens currently free.
JEV_INPUT_USD_PER_MILLION=0.042

# Copy to .env. Only server-side variables are used.
DATABASE_URL=postgresql://jev:jev_local_password@127.0.0.1:5434/jev?schema=public
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TWELVE_DATA_API_KEY=
FINNHUB_API_KEY=
# 8/minute for Twelve Data Basic. Raise only when your plan allows it.
TWELVE_DATA_CREDITS_PER_MINUTE=8
# medium-term (3-12 months), long-term (1-3 years), or short-term (days-weeks)
INVESTMENT_HORIZON=medium-term
# Explicit synthetic workspace for development. Never a live fallback.
DEMO_MODE=false
# Required for production; HTTP Basic login uses username "personal".
# Use a random password of at least 16 characters and HTTPS outside localhost.
APP_PASSWORD=
# Optional fixed canonical origin for reverse-proxy deployments.
APP_ORIGIN=
# Required only for the HTTP cron endpoint. Use at least 32 random characters.
CRON_SECRET=
# Scheduler uses UTC. Default: every weekday after US market close.
DAILY_CRON=15 22 * * 1-5
# Estimated input price per million tokens; output tokens currently free.
JEV_INPUT_USD_PER_MILLION=0.042

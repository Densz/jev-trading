{
  "name": "jev-trading",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "prisma generate && next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ai": "playwright test --config playwright.ai.config.ts",
    "test:integration": "pnpm test:db && NODE_OPTIONS=--conditions=react-server tsx tests/integration/providers.ts",
    "test:integration:db": "tsx tests/integration/database-snapshots.ts",
    "test:integration:ai": "pnpm test:db && NODE_OPTIONS=--conditions=react-server tsx tests/integration/ai-providers.ts && NODE_OPTIONS=--conditions=react-server tsx tests/integration/deepseek-reasoning.ts",
    "test:db": "tsx scripts/prepare-test-db.ts",
    "db:backup": "tsx scripts/db.ts backup",
    "db:backups": "tsx scripts/db.ts backups",
    "db:restore": "tsx scripts/db.ts restore",
    "analyze:daily": "NODE_OPTIONS=--conditions=react-server tsx scripts/analyze-daily.ts",
    "scheduler": "NODE_OPTIONS=--conditions=react-server tsx scripts/scheduler.ts",
    "demo:seed": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-demo.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@typesafe-ai/sdk": "0.6.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.577.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.8.1",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
